flowchart TD
    %% Define Styles
    classDef mcu fill:#e6ccff,stroke:#9900ff,stroke-width:2px;
    classDef relay fill:#ccffff,stroke:#00cccc,stroke-width:2px;
    classDef ic fill:#ffe0b3,stroke:#ff8800,stroke-width:2px;
    classDef passive fill:#ffffcc,stroke:#cccc00,stroke-width:2px;
    classDef ledGreen fill:#ccffcc,stroke:#009900,stroke-width:2px;
    classDef ledBlue fill:#cce0ff,stroke:#0033cc,stroke-width:2px;
    classDef ledRed fill:#ffcccc,stroke:#cc0000,stroke-width:2px;
    classDef ledYellow fill:#fff2cc,stroke:#cc9900,stroke-width:2px;
    classDef sensor fill:#e0e0e0,stroke:#555555,stroke-width:2px;
    classDef ground fill:#dddddd,stroke:#666666,stroke-width:2px;

    %% ============ ESP32 ============
    subgraph ESP32 ["ESP32 DevKit (OCPP Dispatch Node)"]
        BOOT["GPIO0 (BOOT button)"]:::mcu
        SDA["GPIO21 (I2C SDA)"]:::mcu
        SCL["GPIO22 (I2C SCL)"]:::mcu
        SER["GPIO4 (SER / Data)"]:::mcu
        SRCLK["GPIO5 (SRCLK / Clock)"]:::mcu
        RCLK["GPIO18 (RCLK / Latch)"]:::mcu
        RLY_GPIO1["GPIO13 (Relay1 IN)"]:::mcu
        RLY_GPIO2["GPIO14 (Relay2 IN)"]:::mcu
        RLY_GPIO3["GPIO25 (Relay3 IN)"]:::mcu
        RLY_GPIO4["GPIO26 (Relay4 IN)"]:::mcu
        RLY_GPIO5["GPIO27 (Relay5 IN)"]:::mcu
    end

    %% ============ Shift Register Chain ============
    subgraph ShiftChain ["74HC595 x3 (3.3V VCC) — 24 outputs, 18 used"]
        U1["U1: bits 0-7<br>Bay1 IDLE/CHG/FAULT, Bay2 IDLE/CHG/FAULT, Bay3 IDLE/CHG"]:::ic
        U2["U2: bits 8-15<br>Bay3 FAULT, Bay4 IDLE/CHG/FAULT, Bay5 IDLE/CHG/FAULT, Xfmr SAFE"]:::ic
        U3["U3: bits 16-23<br>Xfmr WARNING/OVERLOAD, 6x spare"]:::ic
    end

    SER --> U1
    SRCLK --> U1
    SRCLK --> U2
    SRCLK --> U3
    RCLK --> U1
    RCLK --> U2
    RCLK --> U3
    U1 -- "Serial out (pin 9)" --> U2
    U2 -- "Serial out (pin 9)" --> U3

    %% ============ Bay 1 (fully detailed; Bays 2-5 identical, see pin table) ============
    subgraph Bay1 ["Bay 1 — EV Charging Point"]
        RELAY1["Relay Module 1<br>(onboard indicator LED)"]:::relay
        LOAD1["Power Resistor<br>22Ω 25W (load)"]:::passive
        R1a["330Ω"]:::passive
        LED1_IDLE((("IDLE<br>green"))):::ledGreen
        R1b["330Ω"]:::passive
        LED1_CHG((("CHARGING<br>blue"))):::ledBlue
        R1c["330Ω"]:::passive
        LED1_FAULT((("FAULT<br>red"))):::ledRed
    end

    RLY_GPIO1 --> RELAY1
    RELAY1 -- "N.O. contact" --> LOAD1
    U1 -- "bit0" --> R1a --> LED1_IDLE
    U1 -- "bit1" --> R1b --> LED1_CHG
    U1 -- "bit2" --> R1c --> LED1_FAULT

    %% ============ Bays 2-5 (collapsed) ============
    Bay2_5["Bays 2-5<br>(identical to Bay 1: relay + 22Ω load resistor + 3 status LEDs each)<br>Relays → GPIO14/25/26/27<br>LEDs → shift-register bits 3-14 (see pin table)"]:::relay
    RLY_GPIO2 --> Bay2_5
    RLY_GPIO3 --> Bay2_5
    RLY_GPIO4 --> Bay2_5
    RLY_GPIO5 --> Bay2_5
    U1 -. "bits 3-7" .-> Bay2_5
    U2 -. "bits 8-14" .-> Bay2_5

    %% ============ Transformer panel ============
    subgraph Xfmr ["Transformer Model — System Status"]
        R_safe["330Ω"]:::passive
        LED_SAFE((("SAFE<br>green"))):::ledGreen
        R_warn["330Ω"]:::passive
        LED_WARN((("WARNING<br>yellow"))):::ledYellow
        R_over["330Ω"]:::passive
        LED_OVER((("OVERLOAD<br>red"))):::ledRed
    end
    U2 -- "bit15" --> R_safe --> LED_SAFE
    U3 -- "bit16" --> R_warn --> LED_WARN
    U3 -- "bit17" --> R_over --> LED_OVER

    %% ============ Sensing + Display ============
    subgraph Sense ["I2C Bus Devices"]
        INA["INA219 Current Sensor<br>(measures total 12V bus current)"]:::sensor
        LCD["16x2 I2C LCD"]:::sensor
    end
    SDA --- INA
    SCL --- INA
    SDA --- LCD
    SCL --- LCD

    %% ============ Ground ============
    GND{"Common Ground Bus<br>(12V supply -, all relay/LED/sensor grounds)"}:::ground
    LOAD1 --> GND
    LED1_IDLE --> GND
    LED1_CHG --> GND
    LED1_FAULT --> GND
    Bay2_5 --> GND
    LED_SAFE --> GND
    LED_WARN --> GND
    LED_OVER --> GND
    INA --> GND
